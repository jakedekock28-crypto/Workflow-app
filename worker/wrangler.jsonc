{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflow-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "triggers": { "crons": ["0 2 * * *"] },
  "vars": {
    "APP_URL": "https://jakedekock28-crypto.github.io/Workflow-app/",
    "GOOGLE_CLIENT_ID": "SET_IN_GOOGLE_CLOUD_CONSOLE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workflow-production",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
